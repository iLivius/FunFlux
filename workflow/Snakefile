rule its_extraction:
    input:
        contigs = nuclear_contigs
    output:
        full = "03.post-processing/ITS_extraction/{sample}/{sample}.full.fasta",
        its1 = "03.post-processing/ITS_extraction/{sample}/{sample}.ITS1.fasta",
        its2 = "03.post-processing/ITS_extraction/{sample}/{sample}.ITS2.fasta",
        summary = "03.post-processing/ITS_extraction/{sample}/{sample}.summary.txt"
    params:
        basename = "03.post-processing/ITS_extraction/{sample}/{sample}"
    resources:
        cpus = min(CPUS, 24)
    conda:
        "envs/itsx.yaml"
    message:
        "--- ITS marker extraction from contigs. ---"
    log:
        "logs/its_extraction_{sample}.log"
    priority: 5    
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname "{params.basename}")

        temp_dir="{params.basename}.ITSx_tmp"
        rm -rf "$temp_dir"
        mkdir -p "$temp_dir"
        trap 'rm -rf "$temp_dir"' EXIT

        ITSx \
            -i {input.contigs} \
            -o {params.basename} \
            --temp "$temp_dir" \
            --preserve T \
            --only_full F \
            --graphical F \
            --complement T \
            --positions F \
            --not_found F \
            -E 0.001 \
            --plus T \
            --nhmmer T \
            --cpu {resources.cpus} > {log} 2>&1
        """

rule its_classification:
    input:
        its1 = "03.post-processing/ITS_extraction/{sample}/{sample}.ITS1.fasta",
        its2 = "03.post-processing/ITS_extraction/{sample}/{sample}.ITS2.fasta",
        its_db = UNITE_FASTA
    output:
        its1_tax = "03.post-processing/ITS_extraction/{sample}/{sample}_ITS1_taxonomy.txt",
        its2_tax = "03.post-processing/ITS_extraction/{sample}/{sample}_ITS2_taxonomy.txt"
    params:
        cutoff = ITS_TAXONOMY_CUTOFF
    resources:
        cpus = min(CPUS, 24)
    conda:
        "envs/vsearch.yaml"
    message:
        "--- VSEARCH: Classifying ITS sequences using UNITE db. ---"
    log:
        "logs/classify_its_{sample}.log"
    priority: 4
    shell:
        """
        # Launch VSEARCH if the output of ITSx is not empty
        if [ -s {input.its1} ]; then
            vsearch \
                --sintax {input.its1} \
                --db {input.its_db} \
                --tabbedout {output.its1_tax} \
                --sintax_cutoff {params.cutoff} \
                --threads {resources.cpus} >> {log} 2>&1
        else
            echo "ITS1 FASTA file is empty for sample {wildcards.sample}. Skipping classification." >> {log} 2>&1
            touch {output.its1_tax}
        fi

        if [ -s {input.its2} ]; then
            vsearch \
                --sintax {input.its2} \
                --db {input.its_db} \
                --tabbedout {output.its2_tax} \
                --sintax_cutoff {params.cutoff} \
                --threads {resources.cpus} >> {log} 2>&1
        else
            echo "ITS2 FASTA file is empty for sample {wildcards.sample}. Skipping classification." >> {log} 2>&1
            touch {output.its2_tax}
        fi
        """

rule multiqc:
    input:
        fastp_json = expand("01.pre-processing/{sample}_fastp.json", sample=CHECK_SAMPLES),
        qualimap_dir = expand("03.post-processing/mapping_evaluation/{sample}", sample=CHECK_SAMPLES),
        quast_dir = expand("03.post-processing/assembly_evaluation/{sample}", sample=CHECK_SAMPLES),
        busco_dir = expand("03.post-processing/completeness_evaluation/{sample}", sample=CHECK_SAMPLES)
    output:
        multiqc_dir = directory("report"),
        multiqc_yaml = temp("report/multiqc_config.yaml")
    conda:
        "envs/multiqc.yaml"
    message:
        "--- MultiQC: Aggregate results. ---"
    log:
        "logs/multiqc.log"
    priority: 4      
    shell:
        r"""
        mkdir -p {output.multiqc_dir}

        printf "%s\n" "show_analysis_paths: False" "show_analysis_time: False" > {output.multiqc_yaml}

        cat >> {output.multiqc_yaml} << 'EOF'
sample_names_replace_regex: true
sample_names_replace_exact: true

sample_names_replace:
  '^(?:.* \| )?01\.pre-processing \| *([^|]+?)_fastp$': 'fastp read QC | \1'
  '^(?:.* \| )?01\.pre-processing \| *([^|. ]+)\.1$': 'fastp read QC | \1'
  '^(?:.* \| )?01\.pre-processing \| *([^|]+?) *$': 'fastp read QC | \1'
  '^(?:.* \| )?03\.post-processing \| mapping_evaluation \| *([^|]+?) *\| *([^|]+?)_map *$': 'mapping QC | \2'
  '^(?:.* \| )?03\.post-processing \| mapping_evaluation \| *([^|]+?) *\| raw_data$': 'mapping QC | \1'
  '^(?:.* \| )?03\.post-processing \| mapping_evaluation \| *([^|]+?) *\| raw_data_qualimapReport \| *\1$': 'mapping QC | \1'
  '^(?:.* \| )?03\.post-processing \| assembly_evaluation \| *([^|]+?) *\| *\1 *$': 'QUAST assembly QC | \1'
  '^(?:.* \| )?03\.post-processing \| assembly_evaluation \| *([^|]+?) *\| contigs_sel$': 'QUAST assembly QC | \1'
  '^(?:.* \| )?03\.post-processing \| completeness_evaluation \| *([^|]+?) *\| short_summary\.(?:generic|specific)\.([^.]+_odb(?:10|12))\.\1$': 'BUSCO completeness QC (\2) | \1'
  '^([^| ]+) \| \1_map$': 'mapping QC | \1'
  '^([^| ]+) \| raw_data$': 'mapping QC | \1'
  '^([^| ]+) \| raw_data_qualimapReport \| \1$': 'mapping QC | \1'
  '^([^| ]+) \| contigs_sel$': 'QUAST assembly QC | \1'
  '^([^| ]+) \| short_summary\.(?:generic|specific)\.([^.]+_odb(?:10|12))\.\1$': 'BUSCO completeness QC (\2) | \1'
EOF

        multiqc \
            --config {output.multiqc_yaml} \
            --outdir {output.multiqc_dir} \
            -d \
            {input.fastp_json} \
            {input.qualimap_dir} \
            {input.quast_dir} \
            {input.busco_dir} > {log} 2>&1
        """

rule funannotate_db:
    output:
        db_info = os.path.join(FUNANNOTATEDB, "funannotate-db-info.txt")
    params:
        funannotate_tar_url = FUNANNOTATEURL,
        funannotate_sha_url = FUNANNOTATESHAURL,
        funannotate_tar = os.path.join(FUNANNOTATEDB, f"{FUNANNOTATEID}.tar.gz"),
        funannotate_sha = os.path.join(FUNANNOTATEDB, f"{FUNANNOTATEID}.sha256"),
        funannotate_db = FUNANNOTATEDB
    log:
        "logs/funannotate_db.log"
    message:
        "--- Funannotate: Download and verify funannotate database. ---"
    priority: 10
    shell:
        """
        mkdir -p "{params.funannotate_db}"

        # If SHA file not present, download both SHA and TAR
        if [ ! -f "{params.funannotate_sha}" ]; then
            echo "[funannotate_db] sha file not found, downloading sha and tar.gz files" > {log}

            # Download SHA
            curl -L --fail -o "{params.funannotate_sha}" "{params.funannotate_sha_url}" >> {log} 2>&1

            # Download TAR
            curl -L --fail -o "{params.funannotate_tar}" "{params.funannotate_tar_url}" >> {log} 2>&1
        else
            echo "[funannotate_db] sha file exists: {params.funannotate_sha} (skip download)" >> {log}

            # Ensure tar exists; if missing, download only tar
            if [ ! -f "{params.funannotate_tar}" ]; then
                echo "[funannotate_db] missing, downloading tar.gz only" >> {log}
                curl -L --fail -o "{params.funannotate_tar}" "{params.funannotate_tar_url}" >> {log} 2>&1
            fi
        fi

        tar -xzf "{params.funannotate_tar}" --strip-components=1 -C "{params.funannotate_db}" >> {log} 2>&1
        """


rule normalize_funannotate_db:
    input:
        db_info = os.path.join(FUNANNOTATEDB, "funannotate-db-info.txt")
    output:
        metadata = "00.database/funannotate_db_paths.normalized.json"
    params:
        funannotate_db = FUNANNOTATEDB
    log:
        "logs/funannotate_db_paths.normalized.log"
    message:
        "--- Funannotate: Normalize trained-species database paths. ---"
    priority: 9
    run:
        import json

        summary = normalize_funannotate_db_paths(params.funannotate_db)
        summary["database"] = os.path.abspath(params.funannotate_db)

        os.makedirs(os.path.dirname(output.metadata), exist_ok=True)
        temporary = output.metadata + ".tmp"
        with open(temporary, "w") as handle:
            json.dump(summary, handle, indent=2)
            handle.write("\n")
        os.replace(temporary, output.metadata)

        os.makedirs(os.path.dirname(log[0]), exist_ok=True)
        with open(log[0], "w") as handle:
            handle.write(
                "[normalize_funannotate_db] normalized "
                f"{summary['metadata_paths_updated']} trained-species path(s) "
                f"across {summary['metadata_files']} metadata file(s), and "
                f"{summary['database_info_paths_updated']} database-index path(s).\n"
            )


rule funannotate_preprocess:
    input:
        contigs = nuclear_contigs,
        db_metadata = "00.database/funannotate_db_paths.normalized.json"
    output:
        contigs_clean = "04.annotation/{sample}/contigs_clean.fasta",
        contigs_sort = "04.annotation/{sample}/contigs_sort.fasta"
    params:
        funannotate_db = FUNANNOTATEDB
    resources:
        cpus = CPUS
    conda:
        "envs/funannotate.yaml"
    message:
        "--- Funannotate: Clean and sort contigs before masking. ---"
    log:
        "logs/funannotate_preprocess_{sample}.log"
    priority: 4
    shell:
        """
        set -euo pipefail

        export FUNANNOTATE_DB="{params.funannotate_db}"

        funannotate clean \
            -i {input.contigs} \
            -o {output.contigs_clean} > {log} 2>&1

        funannotate sort \
            -i {output.contigs_clean} \
            -o {output.contigs_sort} \
            --minlen 0 >> {log} 2>&1
        """

rule repeat_masking:
    input:
        contigs_sort = "04.annotation/{sample}/contigs_sort.fasta"
    output:
        contigs_mask = "04.annotation/{sample}/contigs_mask.fasta"
    params:
        method = MASKING_METHOD,
        work_dir = "04.annotation/{sample}/repeatmasking",
        quick_arg = "-quick" if REPEATMODELER_QUICK else "",
        ltrstruct_arg = "-LTRStruct" if REPEATMODELER_LTRSTRUCT else ""
    threads:
        min(CPUS, 12)
    conda:
        "envs/repeatmasking.yaml"
    message:
        "--- Repeat masking: Softmask contigs. ---"
    log:
        "logs/repeat_masking_{sample}.log"
    priority: 4
    shell:
        """
        set -euo pipefail

        mkdir -p logs
        input_fasta=$(readlink -f {input.contigs_sort})
        output_fasta=$(readlink -f {output.contigs_mask})
        log_file=$(readlink -f {log})
        work_dir="{params.work_dir}"

        rm -rf "$work_dir"
        mkdir -p "$work_dir"

        if [ "{params.method}" = "tantan" ]; then
            tantan "$input_fasta" > "$output_fasta" 2> "$log_file"
        elif [ "{params.method}" = "repeatmodeler_repeatmasker" ]; then
            cd "$work_dir"
            BuildDatabase -name {wildcards.sample}_rm "$input_fasta" > "$log_file" 2>&1
            RepeatModeler -database {wildcards.sample}_rm -threads {threads} {params.quick_arg} {params.ltrstruct_arg} >> "$log_file" 2>&1
            families="{wildcards.sample}_rm-families.fa"
            if [ ! -s "$families" ] && [ -s "consensi.fa.classified" ]; then
                families="consensi.fa.classified"
            fi
            if [ ! -s "$families" ]; then
                echo "RepeatModeler did not produce a usable repeat library." >> "$log_file"
                exit 1
            fi
            RepeatMasker -pa {threads} -xsmall -lib "$families" -dir . "$input_fasta" >> "$log_file" 2>&1
            cp "$(basename "$input_fasta").masked" "$output_fasta"
        fi
        """

rule funannotate_prediction:
    input:
        contigs_mask = "04.annotation/{sample}/contigs_mask.fasta",
        db_metadata = "00.database/funannotate_db_paths.normalized.json"
    output:
        funannotate_dir = directory("04.annotation/{sample}/funannotate")
    params:
        genemark_dir = GENEMARKDIR,
        genemark_enabled = str(GENEMARK_ENABLED).lower(),
        funannotate_db = FUNANNOTATEDB,
        species = lambda wildcards: annotations[wildcards.sample]['species_name'],
        proteins = lambda wildcards: annotations[wildcards.sample]['protein_file'],
        model = lambda wildcards: annotations[wildcards.sample]['augustus_model'],
    resources:
        cpus = CPUS
    conda:
        "envs/funannotate.yaml"
    message:
        "--- Funannotate: Gene prediction. ---"
    log:
        "logs/funannotate_prediction_{sample}.log"
    priority: 3
    shell:
        """
        export FUNANNOTATE_DB="{params.funannotate_db}"
        # Prevent an unconfigured licensed GeneMark installation on the host
        # from being found implicitly by Funannotate.
        export PATH="$CONDA_PREFIX/bin:/usr/bin:/bin"
        unset GENEMARK_PATH
        if [ "{params.genemark_enabled}" = "true" ]; then
            export GENEMARK_PATH="{params.genemark_dir}"
        fi

        funannotate predict \
            -i {input.contigs_mask} \
            -o {output.funannotate_dir} \
            -s "{params.species}" \
            --name {wildcards.sample} \
            --strain {wildcards.sample} \
            --augustus_species {params.model} \
            --protein_evidence {params.proteins} {params.funannotate_db}/uniprot_sprot.fasta \
            --cpus {resources.cpus} >> {log} 2>&1
        """

rule iprscan_annotation:
    input:
        funannotate_dir = "04.annotation/{sample}/funannotate"
    output:
        iprscan_out = "04.annotation/{sample}/iprscan/interproscan_out.xml"
    params:
        iprscan = IPRSCAN
    resources:
        # InterProScan benefits from multiple CPUs, but very high values can be
        # inefficient and may put unnecessary pressure on shared systems.
        cpus = min(CPUS, 10)
    conda:
        # Keep InterProScan in its own Java 11 environment. The main
        # funannotate environment can still resolve with Java 8 dependencies.
        "envs/interproscan.yaml"
    message:
        "--- InterProScan: Gene annotation. ---"
    log:
        "logs/iprscan_annotation_{sample}.log"
    priority: 3
    shell:
        """
        # Fail immediately on command errors, unset variables, or broken pipes.
        set -euo pipefail

        # Work with absolute paths where possible, so the rule is robust to
        # Snakemake changing directories internally.
        funannotate_dir=$(readlink -f {input.funannotate_dir})

        # Create the InterProScan output directory before resolving its absolute
        # path. This makes the rule safe on a completely fresh output directory.
        iprscan_dir=$(dirname "{output.iprscan_out}")
        mkdir -p "$iprscan_dir"
        iprscan_dir=$(readlink -f "$iprscan_dir")
        iprscan_xml="$iprscan_dir/$(basename "{output.iprscan_out}")"

        # InterProScan works on predicted proteins. Funannotate normally writes
        # them under predict_results, but update_results is also checked for
        # compatibility with workflows that include a funannotate update step.
        proteins=""
        for results_dir in "$funannotate_dir/predict_results" "$funannotate_dir/update_results"; do
            if [ -d "$results_dir" ]; then
                proteins=$(find "$results_dir" -maxdepth 1 -type f -name "*.proteins.fa" -print -quit)
                if [ -n "$proteins" ]; then
                    break
                fi
            fi
        done

        # Stop here if gene prediction did not produce a protein FASTA. Running
        # InterProScan without a real input would only create a misleading error.
        if [ -z "$proteins" ]; then
            echo "Could not find a *.proteins.fa file in $funannotate_dir/predict_results or update_results." > {log}
            exit 1
        fi

        # Remove any previous XML before the run. A stale file must never be
        # mistaken for a successful InterProScan result.
        rm -f "$iprscan_xml"
        echo "Running InterProScan directly on $proteins" > {log}

        # Run InterProScan directly instead of the funannotate iprscan wrapper.
        # This avoids wrapper-level XML assembly issues with newer InterProScan
        # releases while still producing the XML expected by funannotate annotate.
        "{params.iprscan}" \
            -i "$proteins" \
            -f XML \
            -goterms \
            -pa \
            -cpu {resources.cpus} \
            -o "$iprscan_xml" >> {log} 2>&1

        # Validate the XML before handing it to downstream annotation. This
        # catches empty, truncated, malformed, or wrong-type XML at the source.
        python - "$iprscan_xml" >> {log} 2>&1 <<'PY'
import sys
import xml.etree.ElementTree as ET

# The shell passes the InterProScan XML path as the first Python argument.
path = sys.argv[1]
try:
    # Parse the XML and keep the root element for a type check.
    root = ET.parse(path).getroot()
except Exception as exc:
    sys.stderr.write("InterProScan XML validation failed for %s: %s\\n" % (path, exc))
    sys.exit(1)

# XML namespaces can prefix the tag with a namespace block before protein-matches.
# chr(125) is the closing curly brace; spelling it this way avoids confusing
# Snakemake's own brace-based string formatting.
tag = root.tag.split(chr(125))[-1]
if tag != "protein-matches":
    sys.stderr.write("InterProScan XML validation failed for %s: unexpected root tag '%s'\\n" % (path, root.tag))
    sys.exit(1)
PY
        """

