# Sample names become filenames, report labels, and Funannotate IDs. These
# characters are rejected because they make paths or downstream IDs ambiguous.
not_allowed_chars = set("_*#@%^/! ?&:;|<>")

# Pull config values into clear names. Rules below should read as workflow
# steps, not repeated config dictionary access.
workdir: config['directories']['output_dir']
