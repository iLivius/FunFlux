        {output.eggnog_dir}/{wildcards.sample}.emapper.annotations
    """

if SIGNALP6_ENABLED:
    rule install_signalp6:
        input:
            archive = SIGNALP6_ARCHIVE
        output:
            manifest = "00.resources/signalp6/installation.json"
        params:
            mode = SIGNALP6_MODE,
            archive_sha256 = SIGNALP6_ARCHIVE_SHA256
        conda:
            "envs/signalp6.yaml"
        message:
            "--- SignalP 6: Installing the configured official DTU archive. ---"
        script:
            "scripts/install_signalp6.py"

    rule signalp6_annotation:
        input:
            funannotate_dir = "04.annotation/{sample}/funannotate",
            installation = "00.resources/signalp6/installation.json"
        output:
            signalp_results = "04.annotation/{sample}/signalp6/prediction_results.txt"
        params:
            protein_file = lambda wildcards: os.path.join(
                "04.annotation",
                wildcards.sample,
                "funannotate",
                "predict_results",
                f"{annotations[wildcards.sample]['species_name'].replace(' ', '_')}_{wildcards.sample}.proteins.fa"
            ),
            mode = SIGNALP6_MODE,
            batch_size = SIGNALP6_BATCH_SIZE
        threads:
            SIGNALP6_TORCH_NUM_THREADS
        conda:
            "envs/signalp6.yaml"
        message:
            "--- SignalP 6: Secreted-protein prediction for Funannotate. ---"
        log:
            "logs/signalp6_annotation_{sample}.log"
        priority: 3
        shell:
            """
            set -euo pipefail

            : > "{log}"
            proteins=$(readlink -f "{params.protein_file}")
            if [ ! -s "$proteins" ]; then
                echo "Funannotate did not produce the expected non-empty protein FASTA: $proteins" >> "{log}"
                exit 1
            fi
            output_dir=$(dirname "{output.signalp_results}")
            output_dir=$(readlink -m "$output_dir")
            parent_dir=$(dirname "$output_dir")
            mkdir -p "$parent_dir"
            temporary_dir=$(mktemp -d "$parent_dir/.signalp6-{wildcards.sample}.XXXXXX")
            trap 'rm -rf -- "$temporary_dir"' EXIT
            export MPLCONFIGDIR="$temporary_dir/.matplotlib"
            mkdir -p "$MPLCONFIGDIR"

            installation=$(readlink -f "{input.installation}")
            model_dir=$(python -c 'import json, os, sys; manifest = os.path.abspath(sys.argv[1]); data = json.load(open(manifest)); print(os.path.abspath(os.path.join(os.path.dirname(manifest), data["model_dir"])))' "$installation")
            if [ ! -d "$model_dir" ]; then
                echo "SignalP installation manifest points to a missing model directory: $model_dir" >> "{log}"
                exit 1
            fi

            # Funannotate protein headers contain a stable transcript ID followed
            # by a description. SignalP preserves the whole header in column 1,
            # whereas Funannotate maps only the transcript ID. Run SignalP on a
            # temporary ID-only FASTA so its native table can be parsed exactly.
            signalp_proteins="$temporary_dir/proteins.for_signalp.faa"
            if ! awk '
                /^>/ {{
                    identifier = substr($0, 2)
                    sub(/[[:space:]].*$/, "", identifier)
                    if (identifier == "" || seen[identifier]++) exit 1
                    print ">" identifier
                    next
                }}
                {{ print }}
            ' "$proteins" > "$signalp_proteins"; then
                echo "Could not create a unique ID-only protein FASTA for SignalP." >> "{log}"
                exit 1
            fi
            if [ ! -s "$signalp_proteins" ]; then
                echo "The ID-only protein FASTA for SignalP is empty." >> "{log}"
                exit 1
            fi

            echo "Running SignalP 6 from the dedicated workflow environment on ID-normalized Funannotate proteins" >> "{log}"
            signalp6 \
                --fastafile "$signalp_proteins" \
                --organism eukarya \
                --output_dir "$temporary_dir" \
                --format none \
                --mode "{params.mode}" \
                --torch_num_threads {threads} \
                --write_procs 1 \
                --bsize {params.batch_size} \
                --model_dir "$model_dir" >> "{log}" 2>&1

            results="$temporary_dir/prediction_results.txt"
            if [ ! -s "$results" ]; then
                echo "SignalP 6 did not create a non-empty prediction_results.txt file." >> {log}
                exit 1
            fi
            if ! grep -q '^# SignalP-6' "$results"; then
                echo "SignalP output is not a SignalP 6 prediction summary." >> {log}
                exit 1
            fi
            if ! awk -F '\t' '
                /^#/ {{ next }}
                NF < 5 {{ invalid = 1; next }}
                {{ records += 1 }}
                END {{ exit(invalid || records == 0) }}
            ' "$results"; then
                echo "SignalP 6 summary is empty or does not have the columns Funannotate parses." >> {log}
                exit 1
            fi

            # Replace the whole rule-owned directory only after validation, so
            # a failed rerun cannot leave partial SignalP files as valid output.
            rm -rf -- "$output_dir"
            mv "$temporary_dir" "$output_dir"
            trap - EXIT
            """


rule funannotate_annotation:
    input:
        funannotate_dir = "04.annotation/{sample}/funannotate",
        iprscan_out = "04.annotation/{sample}/iprscan/interproscan_out.xml",
        eggnog_dir = "04.annotation/{sample}/eggnog",
        antismash_dir = "04.annotation/{sample}/antismash",
        signalp_results = lambda wildcards: (
            "04.annotation/{sample}/signalp6/prediction_results.txt".format(
                sample=wildcards.sample
            ) if SIGNALP6_ENABLED else []
        )
    output:
        annotate_complete = "04.annotation/{sample}/.annotation_complete.txt"
    params:
        funannotate_db = FUNANNOTATEDB,
        signalp_enabled = str(SIGNALP6_ENABLED).lower()
    resources:
        cpus = min(CPUS, 24)
    conda:
        "envs/funannotate.yaml"
    message:
        "--- Funannotate: Functional annotation. ---"
    log:
        "logs/funannotate_annotation_{sample}.log"
    priority: 2    
    shell:
        """
        set -euo pipefail

        # Set funannotate db directory as environmental variable, again
        export FUNANNOTATE_DB="{params.funannotate_db}"

        funannotate_dir=$(readlink -f {input.funannotate_dir})
        antismash_gbk=$(readlink -f {input.antismash_dir}/antismash.gbk)
        iprscan_xml=$(readlink -f {input.iprscan_out})
        eggnog_annotations=$(readlink -f {input.eggnog_dir}/{wildcards.sample}.emapper.annotations)
        log_file=$(readlink -f {log})
        complete_file=$(readlink -f {output.annotate_complete})
        annotate_work="$funannotate_dir/annotate_work"
        signalp_args=()

        if [ "{params.signalp_enabled}" = "true" ]; then
            signalp_results=$(readlink -f {input.signalp_results})
            if [ ! -s "$signalp_results" ]; then
                echo "Expected non-empty SignalP 6 results at $signalp_results" > "$log_file"
                exit 1
            fi
            signalp_args=(--signalp "$signalp_results")
        fi

        mkdir -p "$annotate_work"
        cd "$annotate_work"

        # SignalP is supplied explicitly above. Restrict PATH so an ambient
        # installation cannot make an off-config run perform hidden predictions.
        export PATH="$CONDA_PREFIX/bin:/usr/bin:/bin"

        funannotate annotate \
            -i "$funannotate_dir" \
            --antismash "$antismash_gbk" \
            --iprscan "$iprscan_xml" \
            --eggnog "$eggnog_annotations" \
            "${{signalp_args[@]}}" \
            --cpus {resources.cpus} > "$log_file" 2>&1

        if [ "{params.signalp_enabled}" = "true" ] && [ ! -e "$funannotate_dir/annotate_misc/annotations.secretome.txt" ]; then
            echo "Funannotate did not create annotations.secretome.txt from the supplied SignalP 6 results." >> "$log_file"
            exit 1
        fi

        if [ -s genome.fixedproducts ]; then
            mkdir -p "$funannotate_dir/annotate_misc"
            mv genome.fixedproducts "$funannotate_dir/annotate_misc/genome.fixedproducts"
        fi

        # Create a dummy file to execute the rule, since funannotate ignores the -o option
        touch "$complete_file"

        # Cleanup process
        rm -f "$funannotate_dir"/*.log
        rm -f "$annotate_work"/funannotate-annotate.*.log
        rmdir "$annotate_work" 2>/dev/null || true
        """

rule cleanup:
    input:
        annotate_complete = "04.annotation/{sample}/.annotation_complete.txt",
    output:
        cleanup_complete = "04.annotation/{sample}/.cleanup_complete.txt"
    message:
        "--- Cleaning up the output dir. ---"
    log:
        "logs/cleanup_{sample}.log"
    priority: 1    
    shell:
        """
        # Check if the .annotation_complete.txt file exists
        if [ -f {input.annotate_complete} ]; then

            # Perform the cleanup
            rm -rf 04.annotation/{wildcards.sample}/clean_*
            rm -rf 04.annotation/{wildcards.sample}/*.log
            rm -rf 04.annotation/{wildcards.sample}/genome.fixedproducts

            # Create a dummy file to execute the rule
            touch {output.cleanup_complete}
        fi    
        """
