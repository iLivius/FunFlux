# GeneMark-ES/ET is an optional, separately licensed predictor.  It is used
# only when an eligible user explicitly supplies its installation directory;
# otherwise Funannotate is deliberately shielded from ambient GeneMark PATHs
# and follows its supported no-GeneMark prediction branch.
GENEMARK = PARAMETERS.get("genemark", {}) or {}
if not isinstance(GENEMARK, dict):
    raise ValueError("parameters.genemark must be a mapping")
_genemark_allowed_keys = {"mode"}
_unknown_genemark_keys = sorted(set(GENEMARK) - _genemark_allowed_keys)
if _unknown_genemark_keys:
    raise ValueError(
        "Unsupported parameters.genemark key(s): "
        + ", ".join(_unknown_genemark_keys)
        + ". Supported keys: "
        + ", ".join(sorted(_genemark_allowed_keys))
    )
_genemark_mode = str(GENEMARK.get("mode", "auto")).strip().lower()
if _genemark_mode in {"off", "false", "0", "no", "none", "null"}:
    GENEMARK_ENABLED = False
elif _genemark_mode == "auto":
    GENEMARK_ENABLED = bool(GENEMARKDIR)
else:
    raise ValueError("parameters.genemark.mode must be auto or off")
if GENEMARK_ENABLED:
    if not os.path.isabs(GENEMARKDIR):
        raise ValueError("directories.genemark_dir must be an absolute path when GeneMark is enabled")
    _genemark_executable = os.path.join(GENEMARKDIR, "gmes_petap.pl")
    if not os.path.isfile(_genemark_executable) or not os.access(_genemark_executable, os.X_OK):
        raise ValueError(
            "directories.genemark_dir must contain an executable gmes_petap.pl when GeneMark is enabled"
        )

