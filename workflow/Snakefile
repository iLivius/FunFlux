# FunFlux v2.0.0 — Unified fungal whole-genome workflow (workflow/Snakefile).
#
# The entry point: the file Snakemake reads first. It prints the banner, reads the rule
# files in a fixed order, and ends with two rules that only gather files: rule all, the
# list of files a finished run must contain, and rule download_all, which fetches only
# what the run downloads (to prepare a run for compute nodes without internet). The
# settings, the checks and the helper functions live in rules/shared/00_common.smk, and
# every other rule lives in a rule file under rules/.
#
# One Snakefile, four input modes. config["mode"] selects the pipeline:
#   illumina → Illumina paired-end short reads            (rules/illumina/*.smk)
#   longread → Oxford Nanopore and/or PacBio HiFi reads   (rules/longread/*.smk)
#   hybrid   → Illumina + long reads, Illumina-guided      (rules/hybrid/*.smk)
#   contigs  → a genome you already have (was Funnotator)  (rules/contigs/*.smk)
# Each mode's own rules (its front end) end with contigs_all.fasta: the screened genome,
# polished where the mode polishes. Everything after the assembly is shared: one copy of
# each rule in rules/shared/*.smk, used by all four modes: decontamination → mitochondrion
# split → assembly QC (QUAST, BUSCO) → ITS taxonomy → repeat masking → gene prediction →
# functional annotation (InterProScan, antiSMASH, eggNOG, SignalP 6) → report. The optional
# screen for antifungal resistance mutations (ChroQueTas) reads the finished genome and
# feeds the report too.
#
# Run from the repository root:
#   snakemake --sdm conda --cores N --configfile config/config.yaml
# (--sdm is the short form of --software-deployment-method. With "conda", Snakemake
#  builds each rule's own conda environment the first time a run needs it, and reuses it
#  afterwards.)

import glob
import os

from snakemake.utils import min_version

# The oldest Snakemake FunFlux v2 runs with: 9.14.6, the version it was developed and validated
# with. min_version stops the run at once, with a message naming the version it needs, on any
# older Snakemake. A later 9.x release should work; the installation guide asks for
# "snakemake>=9.14.6,<10", because a new major version may change options FunFlux relies on.
min_version("9.14.6")

# Keep a user's personal pip packages out of every conda environment.
#
# Python adds ~/.local/lib/python3.X/site-packages to the places it loads packages
# from, X being its own version. A tool in a conda environment with Python 3.12
# therefore also sees anything the user once installed with `pip install --user` for
# Python 3.12 on the host, and a stray or older package there can be loaded instead of
# the environment's own copy. That is a "works on my machine" failure: the environment
# files are identical, the extra package does not show up in them, and only one person
# hits it.
#
# PYTHONNOUSERSITE=1 tells Python to skip that folder. It is set here, in the process
# that starts every job, so every rule inherits it without any change to the rules.
os.environ["PYTHONNOUSERSITE"] = "1"

# The banner. Printed every time Snakemake reads the workflow (dry runs included), before
# 00_common.smk prints the mode and checks the settings. r''' keeps the backslashes of
# the logo as they are.
print(r'''
__________             _______________
___  ____/___  ___________  ____/__  /___  _____  __
__  /_   _  / / /_  __ \_  /_   __  /_  / / /_  |/_/
_  __/   / /_/ /_  / / /  __/   _  / / /_/ /__>  <
/_/      \__,_/ /_/ /_//_/      /_/  \__,_/ /_/|_|

FunFlux v2.0.0
Unified genomic analysis of fungal genomes
Illumina · Long reads (ONT, PacBio HiFi) · Hybrid · Pre-assembled contigs

Livio Antonielli and Günter Brader, 2026
''')

# NO default `configfile:` here, on purpose.
#
# Snakemake MERGES a `configfile:` written in the Snakefile with the --configfile given
# on the command line; it does not replace it. A default pointing at the shipped config
# template would therefore quietly fill in every key the user's own copy leaves out
# (with the template's empty placeholders or its default download links), and the run
# would carry on against a path that does not exist instead of stopping. So the config
# is REQUIRED on the command line, and 00_common.smk stops with a clear message when none
# is given. The message shows the command:
#
#   snakemake --sdm conda --cores N --configfile config/config.yaml
#
# `--cores N` is the ONE setting for CPUs. Every rule that uses several CPUs declares
# Snakemake's own `threads:`, so --cores alone sets the ceiling. On a single computer,
# do NOT also pass `--jobs`/`-j`. Given alone, --jobs is just another name for --cores
# in a local run. Given together with --cores, it limits the number of jobs running at
# once instead, and Snakemake stops counting their threads against --cores, so rules
# can use more CPUs than the machine has. (Checked with Snakemake 9.14.6: with --cores 4
# --jobs 8, four jobs of 4 threads each ran at the same time; with --cores 4 alone they
# ran one after another.)
# On a cluster (--executor slurm and the like) it is the other way round: Snakemake
# refuses to start without --jobs N, the number of jobs it may have queued at once.
# Each job asks the scheduler for its rule's threads, and the heavy steps for the
# memory and time set by resources.ram_gb and resources.runtime_hours (00_common.smk,
# section 4).

# The rule files are read in four steps, in this order. `include:` reads another file
# as if it were written here; a relative path, as in step 1, is taken from the folder
# this file sits in (workflow/). workflow.basedir is that folder as an absolute path, so
# the paths built in steps 2 to 4 also work wherever Snakemake was started from.
#
# 1) Foundation: rules/shared/00_common.smk. It checks config["mode"], works out the
#    output folder and the database paths, finds the samples of the ACTIVE mode only,
#    checks every setting, and defines every shared name and helper function, including
#    MODE and all_targets(), both used below. It MUST come first: the steps below and
#    rule all can only use names it has already created.
#    It deliberately does NOT set a working directory. The v1 workflows used Snakemake's
#    `workdir:`; v2 builds every path from one absolute output folder instead, so
#    Snakemake itself never changes directory and a relative input path means what the
#    user expects (relative to where snakemake was started; reasoning in 00_common.smk,
#    section 3).
include: "rules/shared/00_common.smk"

# 2) The active mode's own rule files, the front end (read QC, assembly, polishing; in
#    contigs mode, the contig filter and, with the screen, finalize_assembly): every .smk
#    file in rules/<MODE>/. The pattern has * for "any name", e.g.
#    workflow/rules/contigs/*.smk in contigs mode. glob.glob lists the files that match,
#    and sorting the names keeps their numeric order (10_, 20_, ...). Should a mode's
#    folder hold no .smk file (a checkout with a front end removed), the list is empty,
#    nothing is included, and the workflow is still read without error. The other half of
#    that safety is in 00_common.smk: all_targets() returns nothing while the folder is
#    empty (see rule all at the bottom).
_frontend_pattern = os.path.join(workflow.basedir, "rules", MODE, "*.smk")
_frontend_files = sorted(glob.glob(_frontend_pattern))
for _smk in _frontend_files:
    include: _smk

# 3) The shared rule files (05_ont_adapters ... 50_amr), in numeric order. Found by
#    listing the folder, not written out by hand, so that the workflow could be read
#    before these files existed. 00_common is already included (step 1) and 90_report
#    comes last (step 4), so both are skipped here.
#    Some shared files define rules only in some runs: 10_decontam and 15_mitochondria
#    only with the contamination screen (SCREEN), 41_genemark only with GeneMark-ES
#    (GENEMARK_ENABLED), 45_signalp6 only with SignalP 6 (SIGNALP6_ENABLED), 50_amr only
#    with the AMR screen (AMR_ENABLED), 12_medaka_check only for ONT samples polished
#    with Medaka (MEDAKA_SAMPLES), and 05_ont_adapters only for ONT samples whose adapters
#    are trimmed (ONT_TRIM_SAMPLES). Each one wraps its rules in an `if` on its flag, so
#    including every file in every run defines nothing where a file does not apply. They
#    sit in shared/ so that the modes that need them do not each keep a copy.
_shared_pattern = os.path.join(workflow.basedir, "rules", "shared", "*.smk")
_shared_files = sorted(glob.glob(_shared_pattern))
for _smk in _shared_files:
    if os.path.basename(_smk) in ("00_common.smk", "90_report.smk"):
        continue
    include: _smk

# 4) The report file, last. 90_report.smk gathers the QC results of the run into one
#    MultiQC page. Today the order does not matter: Snakemake works out which job feeds
#    which only after it has read every file. It is kept last anyway, because a reference
#    to another rule's output by name (rules.<name>.output) works only for rules read
#    earlier. The exists() check is the same safety as the folder listings above.
_report_smk = os.path.join(workflow.basedir, "rules", "shared", "90_report.smk")
if os.path.exists(_report_smk):
    include: _report_smk


# Default target: what Snakemake builds when no file or rule is named on the command
# line. Snakemake takes the first rule written in THIS file (rules from included files do
# not count). Rule all is written before rule download_all, so it is the default although
# it comes after every included rule; keep it first.
# all_targets() (from 00_common.smk) returns the final files of this mode's front end
# plus the shared deliverables: assembly QC, ITS, annotation, the AMR summary (AMR screen
# on) and the MultiQC page. For a mode whose rule folder holds no rule file it returns an
# empty list: a dry run then lists rule all as its only job and ends without error,
# instead of failing on targets no rule can make.
rule all:
    input:
        all_targets()


# ───────────── download_all — fetch what this run downloads, and nothing else ─────────────
# What it is for: preparing a run whose Snakemake will run on a computer without
# internet. Every download step is a local rule: it runs on the computer that runs
# Snakemake itself, never on a compute node. So:
#   * download_all is not needed on a single computer with internet, nor on a cluster
#     where Snakemake itself runs on a node with internet (the login node) and sends the
#     jobs to the compute nodes: there, a normal run downloads each file when it first
#     needs it. On a cluster it is still useful to finish the large downloads before any
#     job is queued.
#   * It is needed when Snakemake itself must run on a computer without internet, for
#     example when the whole run goes inside one batch job on a compute node. Run it
#     first on a computer with internet that sees the same storage (the login node or a
#     data-transfer node).
# In both cluster cases BUSCO is the exception: with parameters.busco.lineage: auto (the
# default) every BUSCO job downloads its own data on the compute node (see "What it does
# not fetch" below). Name a lineage when the compute nodes have no internet.
#
# The preparation, in this order, on the computer with internet:
#   (1) snakemake --sdm conda --conda-create-envs-only \
#           --configfile <config>
#   (2) snakemake download_all --sdm conda --cores 4 \
#           --configfile <config>
#   (3) snakemake download_all -n --sdm conda \
#           --configfile <config>
# (1) builds the conda environment of every step of the run. (2) runs the download steps
# of this config and nothing else; add -n to it first to see which ones it plans. Running
# (2) again downloads nothing that is already there. (3) is the check, a dry run of (2):
# it must print "Nothing to be done (all requested files are present and up to date)".
# A line "Rules with missing metadata: funannotate_db" after it is harmless: the
# funannotate database was already in its folder (downloaded by hand, or from another
# launch folder), so Snakemake holds no record of making it. (3) also catches a
# parameters.prediction.busco_db that the funannotate database downloaded in (2) does not
# hold: that check (00_common.smk, section 9d) can only look once the database is on
# disk, and it stops (3) with the command that adds the set, which needs internet
# itself. The real run then finds everything in place and plans no download job. After any change to the config or to the input folders (a new sample, a
# Medaka model, the AMR screen switched on, a lineage named), run (1) to (3) again
# before the real run.
#
# Run (1), (2), (3) and the real run from the same folder, with the same config and the
# same --conda-prefix (if you use one):
#   * relative paths in the config are read from the folder Snakemake is started from;
#   * without --conda-prefix, the environments are built in .snakemake/conda of that
#     folder, and Medaka keeps the model weights the check downloads inside its own
#     environment. Started from another folder, the real run would build the
#     environments (20 GB or more) again, without the Medaka weights, on a computer that
#     has no internet;
#   * with another --conda-prefix it would do the same, and it would also run every
#     download step again: Snakemake notes the folder of each finished step's
#     environment (in .snakemake/ of the launch folder), and re-runs a step whose
#     environment now sits elsewhere (reason: "Software environment definition has
#     changed since last execution"). (3), given the --conda-prefix of the real run,
#     shows this: it plans the downloads again instead of "Nothing to be done".
#
# Write download_all right after `snakemake`. --configfile and --sdm each take one or
# more values, so a name written after them is read as one of their values: at the end
# of the line, download_all would be taken for a second config file, and the run stops
# with "No such file or directory: 'download_all'".
#
# What it fetches. The config decides which of these the run needs; the list
# (download_targets() in rules/shared/00_common.smk) holds exactly those:
#   * the PhiX genome (illumina and hybrid mode);
#   * the funannotate database (about 2.1 GB), into directories.funannotate_db when that
#     folder holds none yet, and the repair of the paths stored inside it;
#   * the UNITE ITS reference, unless directories.unite_db names your own copy;
#   * the telomere repeat database;
#   * the Illumina adapter records of NCBI UniVec, for the contig adapter screen;
#   * the Tiberius fungi model, when Tiberius is on;
#   * ChroQueTas and its FungAMR database, when the AMR screen is on;
#   * the antiSMASH database (about 9 GB), unless directories.antismash_db names your
#     own copy;
#   * the BUSCO lineage data, when parameters.busco.lineage names a lineage;
#   * the Medaka model weights of every ONT sample polished with Medaka (the model check
#     reads the sample's raw reads, so these must be in place).
# The downloads land in 00.resources/ of the output folder, except the funannotate
# database (in its own folder) and the Medaka weights (inside the Medaka environment, or
# in ~/.medaka/data).
#
# What it does not fetch:
#   * what you install yourself and name by path in the config: the BLAST and eggNOG
#     databases, InterProScan, GeneMark-ES and the SignalP 6 archive;
#   * BUSCO's data with parameters.busco.lineage: auto (the default). BUSCO picks the
#     lineage only after it has looked at each genome, so every BUSCO job downloads its
#     own data and needs internet. Name a lineage when the compute nodes have none;
#   * the conda environments: that is command (1).
#
# The note on BUSCO. auto is the default, and it is the one setting that still needs
# internet on the compute nodes, so download_all says so on screen instead of leaving
# it to the comments: _DOWNLOAD_ALL_MESSAGE becomes the rule's message:, the text
# Snakemake prints for the job instead of its usual description, in a dry run and in a
# real run (it is not printed when there is nothing to do). With a named lineage it is
# None, and Snakemake prints the usual description.
if BUSCO_LINEAGE == "auto":
    _DOWNLOAD_ALL_MESSAGE = (
        "[FunFlux] Note: parameters.busco.lineage is auto, so every BUSCO job downloads its "
        "own data and needs internet. If the compute nodes have none, set "
        "parameters.busco.lineage to a lineage (for example hypocreales_odb12; "
        "busco --list-datasets lists them) and run download_all again."
    )
else:
    _DOWNLOAD_ALL_MESSAGE = None

# The rule itself has no output and runs no command, like rule all: asking for it makes
# Snakemake run the steps that make its inputs, and that is all. localrule: True keeps
# it on the computer that runs Snakemake, as the download rules are.
rule download_all:
    localrule: True
    message:
        _DOWNLOAD_ALL_MESSAGE
    input:
        download_targets()
