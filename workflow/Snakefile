        idx1 = "03.post-processing/{sample}/contigs.1.bt2",
        idx2 = "03.post-processing/{sample}/contigs.2.bt2",
        idx3 = "03.post-processing/{sample}/contigs.3.bt2",
        idx4 = "03.post-processing/{sample}/contigs.4.bt2",
